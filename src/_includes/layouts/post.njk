{%- set t = i18n[lang] -%}
{%- set pageUrl = site.url + t.prefix + "blog/" + slug + ".html" -%}
{%- set ogImageUrl = site.url + (lang | ogImage(slug)) -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
{% include "partials/gtag.njk" %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ pageUrl }}" />
{% for l in site.languages %}{% if collections | hasPost(l, slug) %}  <link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}{{ i18n[l].prefix }}blog/{{ slug }}.html" />
{% endif %}{% endfor %}  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/blog/{{ slug }}.html" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="index, follow">
  <meta name="author" content="Tether Link Utility">

  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/favicon.png">

  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:site_name" content="Tether Link Utility">
  <meta property="og:image" content="{{ ogImageUrl }}">
  <meta property="og:image:alt" content="{{ ogTitle or title }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@{{ site.twitter }}">
  <meta name="twitter:title" content="{{ twitterTitle or ogTitle or title }}">
  <meta name="twitter:description" content="{{ twitterDescription or ogDescription or description }}">
  <meta name="twitter:image" content="{{ ogImageUrl }}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{ ldHeadline or title }}",
    "description": "{{ ldDescription or description }}",
    "datePublished": "{{ published }}",
    "dateModified": "{{ modified }}",
    "author": { "@type": "Organization", "name": "Tether Link Utility" },
    "publisher": {
      "@type": "Organization",
      "name": "Tether Link Utility",
      "logo": { "@type": "ImageObject", "url": "{{ site.url }}/favicon.png" }
    },
    "mainEntityOfPage": "{{ pageUrl }}"
  }
  </script>
{% if extraJsonLd %}{{ extraJsonLd }}{% endif %}
{% if region and carrier %}  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ t.blog | dump }}, "item": "{{ site.url }}{{ t.prefix }}blog/" },
      { "@type": "ListItem", "position": 2, "name": {{ region | dump }} },
      { "@type": "ListItem", "position": 3, "name": {{ carrier | dump }}, "item": "{{ pageUrl }}" }
    ]
  }
  </script>
{% endif %}{% if faq %}  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
{% for item in faq %}      { "@type": "Question", "name": {{ item.q | striptags | dump }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | striptags | dump }} } }{% if not loop.last %},{% endif %}
{% endfor %}    ]
  }
  </script>
{% endif %}
{% include "partials/post-style.njk" %}
</head>
<body>

{% set langPath = "blog/" + slug + ".html" %}{% include "partials/blog-nav.njk" %}

<main>
  <article>
{%- set quickHtml = "" -%}{%- if quick -%}{%- set quickHtml -%}{% include "partials/quick-answer.njk" %}{%- endset -%}{%- endif -%}
{%- set faqHtml = "" -%}{%- if faq -%}{%- set faqHtml -%}{% include "partials/faq.njk" %}{%- endset -%}{%- endif -%}
{%- set crumbHtml = "" -%}{%- if region and carrier -%}{%- set crumbHtml -%}{% include "partials/breadcrumb.njk" %}{%- endset -%}{%- endif -%}
{{ content | enhancePost({ quick: quickHtml, faq: faqHtml, breadcrumb: crumbHtml, region: region, slug: slug, posts: collections["posts_" + lang], labels: t.post }) }}  </article>
</main>

{% include "partials/blog-footer.njk" %}


{% include "partials/lang-dropdown-script.njk" %}
</body>
</html>
