  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ground:    #0C0C18;
      --surface:   #141428;
      --elevated:  #1E1E38;
      --border:    #20203A;
      --border-md: #2C2C50;
      --accent:    #E8622A;
      --success:   #00BF8A;
      --text:      #ECEDFF;
      --muted:     #8888B0;
      --dim:       #7C7CA2;
      --success-bg: #0A2018;
    }

    html { scroll-behavior: smooth; }
    [id] { scroll-margin-top: 80px; }

    body {
      background: var(--ground);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, system-ui, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }

    .wrap { max-width: 1200px; margin: 0 auto; padding-left: clamp(20px, 5vw, 80px); padding-right: clamp(20px, 5vw, 80px); }

    /* ── Nav ─────────────────────────────── */
    nav {
      position: sticky; top: 0; z-index: 10;
      background: rgba(12,12,24,0.90);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      padding: 0 clamp(20px, 5vw, 80px);
      display: flex; align-items: center; justify-content: space-between;
      height: 64px;
    }
    .nav-brand {
      font-weight: 700; font-size: 15px; letter-spacing: 0.02em;
      color: var(--text); display: flex; align-items: center; gap: 10px;
    }
    .nav-brand:hover { text-decoration: none; }
    .nav-links { display: flex; gap: 26px; align-items: center; }
    .nav-links a { color: var(--muted); font-size: 14px; }
    .nav-links a:hover { color: var(--text); text-decoration: none; }
    .nav-links a.btn-nav {
      background: var(--accent); color: #fff; font-size: 14px; font-weight: 700;
      padding: 9px 16px; border-radius: 9px; transition: opacity 0.15s;
    }
    .nav-links a.btn-nav:hover { opacity: 0.88; color: #fff; }

    .lang-dropdown { position: relative; }
    .lang-dropdown-toggle {
      display: flex; align-items: center; gap: 6px;
      background: none; border: none; cursor: pointer;
      color: var(--muted); font-size: 14px; font-weight: 600; font-family: inherit; padding: 4px 0;
    }
    .lang-dropdown-toggle:hover { color: var(--text); }
    .lang-dropdown-toggle svg { transition: transform 0.2s ease; }
    .lang-dropdown.is-open .lang-dropdown-toggle svg { transform: rotate(180deg); }
    .lang-dropdown-menu {
      position: absolute; top: calc(100% + 14px); right: 0;
      background: var(--surface); border: 1px solid var(--border-md); border-radius: 10px;
      padding: 6px; min-width: 140px;
      display: none; flex-direction: column;
      box-shadow: 0 12px 30px -8px rgba(0,0,0,0.5);
      z-index: 20;
    }
    .lang-dropdown.is-open .lang-dropdown-menu { display: flex; }
    .lang-dropdown-menu a {
      padding: 8px 12px; border-radius: 6px; font-size: 14px; color: var(--muted);
      white-space: nowrap;
    }
    .lang-dropdown-menu a:hover { background: var(--elevated); color: var(--text); text-decoration: none; }
    .lang-dropdown-menu a.is-current { color: var(--accent); font-weight: 600; }

    .nav-toggle {
      display: none; background: none; border: none; color: var(--text);
      width: 44px; height: 44px; padding: 0; cursor: pointer;
      align-items: center; justify-content: center;
    }
    .nav-toggle svg { display: block; }

    /* ── Hero ────────────────────────────── */
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: 48px;
      align-items: center;
      padding-top: clamp(56px, 8vw, 96px);
      padding-bottom: clamp(56px, 8vw, 96px);
    }
    .hero-content { min-width: 0; }
    .hero-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
    .pill {
      display: inline-flex; align-items: center;
      font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 5px 12px; border-radius: 20px; line-height: 1.4;
    }
    .pill-accent { color: var(--accent); background: rgba(232,98,42,0.08); border: 1px solid rgba(232,98,42,0.3); }
    .pill-muted { color: var(--muted); border: 1px solid var(--border-md); }
    .keep-case { text-transform: none; }

    h1 {
      font-size: clamp(40px, 6vw, 64px);
      font-weight: 800;
      line-height: 1.04;
      letter-spacing: -0.035em;
      text-wrap: balance;
      margin-bottom: 22px;
    }
    h1 span { color: var(--accent); }

    .hero-body {
      font-size: 19px; color: var(--muted); line-height: 1.6;
      max-width: 540px; margin-bottom: 32px;
    }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }

    .hero-trust {
      margin-top: 24px; display: flex; flex-wrap: wrap; gap: 8px 22px;
      font-size: 14px; color: var(--muted); list-style: none;
    }
    .hero-trust li { display: inline-flex; align-items: center; gap: 8px; }
    .hero-trust li::before {
      content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--success); flex-shrink: 0;
    }

    .btn-primary {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--accent); color: #fff;
      font-weight: 700; font-size: 15px;
      padding: 13px 26px; border-radius: 12px;
      transition: opacity 0.15s, transform 0.15s;
    }
    .btn-primary:hover { opacity: 0.88; transform: translateY(-1px); text-decoration: none; }

    /* ── Store badges ────────────────────── */
    .play-badge {
      display: inline-flex; align-items: center; gap: 12px;
      background: #000; color: #fff;
      border: 1px solid #3c3c3c;
      padding: 11px 22px; border-radius: 12px;
      transition: transform 0.15s, border-color 0.15s;
    }
    .play-badge:hover { transform: translateY(-2px); border-color: #6a6a6a; text-decoration: none; }
    .play-badge svg { flex-shrink: 0; }
    .play-badge .pb-text, .ios-soon-badge .pb-text { display: flex; flex-direction: column; line-height: 1.15; }
    .play-badge .pb-eyebrow { font-size: 12px; color: #d0d0d0; letter-spacing: 0.02em; }
    .play-badge .pb-word, .ios-soon-badge .pb-word { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; }
    .ios-soon-badge {
      display: inline-flex; align-items: center; gap: 12px;
      background: transparent; color: var(--text);
      border: 1px dashed var(--border-md);
      padding: 11px 22px; border-radius: 12px;
      cursor: default; user-select: none;
    }
    .ios-soon-badge .pb-eyebrow { font-size: 12px; color: var(--accent); font-weight: 700; letter-spacing: 0.04em; }

    /* ── Hero phone ──────────────────────── */
    .hero-phone { position: relative; display: flex; justify-content: center; align-items: center; }
    .hero-phone::before {
      content: ""; position: absolute; left: 50%; top: 50%;
      width: 420px; height: 420px; margin: -210px 0 0 -210px; border-radius: 50%;
      background: radial-gradient(circle, rgba(0,191,138,0.16), rgba(0,191,138,0) 70%);
      pointer-events: none;
    }
    .hero-phone-frame {
      position: relative;
      width: 290px;
      padding: 7px;
      border-radius: 34px;
      background: #1a1b22;
      box-shadow: 0 30px 70px rgba(0,0,0,0.5), 0 0 0 1px var(--border-md), inset 0 0 0 1px rgba(255,255,255,0.06);
      line-height: 0;
    }
    .hero-phone-frame img { display: block; width: 100%; height: auto; border-radius: 28px; }

    /* ── Sections ────────────────────────── */
    .section {
      border-top: 1px solid var(--border);
      padding-top: clamp(56px, 8vw, 96px);
      padding-bottom: clamp(56px, 8vw, 96px);
    }
    .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 40px; }
    .section h2 {
      font-size: clamp(28px, 3.6vw, 40px); font-weight: 800; letter-spacing: -0.025em; line-height: 1.12;
    }
    .section-head h2 { margin: 0; }
    .section-label {
      font-size: 12px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--dim);
      margin-bottom: 12px;
    }
    .demo-link { font-size: 15px; font-weight: 600; white-space: nowrap; }
    .anchor-alias { display: block; height: 0; }

    /* ── Steps ───────────────────────────── */
    .steps {
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px;
      list-style: none;
    }
    .step { border-top: 2px solid var(--border-md); padding-top: 20px; }
    .step:first-child { border-top-color: var(--accent); }
    .step-num { font-size: 13px; font-weight: 700; color: var(--accent); letter-spacing: 0.06em; margin-bottom: 10px; }
    .step h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; line-height: 1.3; }
    .step p  { font-size: 15px; color: var(--muted); line-height: 1.55; }

    .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 48px; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; }
    .card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .card p { font-size: 15px; color: var(--muted); line-height: 1.55; }
    .notes { margin-top: 24px; font-size: 14px; color: var(--muted); line-height: 1.6; max-width: 920px; }
    .notes strong { color: var(--text); font-weight: 600; }

    /* ── Video showcase ──────────────────── */
    .video-showcase { text-align: center; display: flex; flex-direction: column; align-items: center; }
    .video-showcase h2 { margin-bottom: 32px; }
    .video-frame {
      position: relative;
      width: min(360px, 90vw);
      aspect-ratio: 9 / 16;
      border-radius: 20px;
      overflow: hidden;
      background: var(--elevated);
      box-shadow: 0 24px 60px rgba(0,0,0,0.45), 0 0 0 1px var(--border);
      cursor: pointer;
    }
    .video-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .video-facade-play {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      transition: transform 0.15s ease;
    }
    .video-facade:hover .video-facade-play,
    .video-facade:focus-visible .video-facade-play { transform: scale(1.08); }

    /* ── Platforms ───────────────────────── */
    .platforms-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 56px; align-items: start; }
    .platforms-intro h2 { margin-bottom: 16px; }
    .platforms-intro p { font-size: 16px; color: var(--muted); line-height: 1.6; margin-bottom: 18px; }
    .platforms-intro strong { color: var(--text); }
    .platform-list { list-style: none; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
    .platform { display: flex; align-items: center; gap: 16px; padding: 16px 20px; border-top: 1px solid var(--border); }
    .platform:first-child { border-top: none; }
    .mono {
      width: 40px; height: 40px; flex-shrink: 0; border-radius: 10px; background: var(--elevated);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700; color: var(--muted); letter-spacing: 0.02em;
    }
    .platform-info { flex: 1; min-width: 0; }
    .platform h3 { font-size: 16px; font-weight: 700; line-height: 1.3; }
    .platform p { font-size: 14px; color: var(--muted); line-height: 1.45; }
    .code-chip {
      flex-shrink: 0;
      font-family: ui-monospace, "SF Mono", "Cascadia Code", "Fira Code", monospace;
      font-size: 12px; color: var(--success);
      border: 1px solid rgba(0,191,138,0.25);
      padding: 3px 8px; border-radius: 5px; white-space: nowrap;
    }

    /* ── Pricing ─────────────────────────── */
    .pricing-cards { display: flex; flex-wrap: wrap; gap: 20px; }
    .price-card {
      width: 340px; max-width: 100%;
      background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px;
    }
    .price-card.pro { border-color: var(--accent); box-shadow: 0 0 0 4px rgba(232,98,42,0.08); }
    .price-card h3 { font-size: 15px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
    .price-card.pro h3 { color: var(--accent); }
    .price { display: flex; align-items: baseline; flex-wrap: wrap; margin-bottom: 20px; }
    .price span:first-child { margin-right: 6px; }
    .price b + span { margin-left: 2px; }
    .price b { font-size: 40px; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }
    .price span { font-size: 15px; color: var(--muted); }
    .price-card ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .price-card li { font-size: 15px; display: flex; gap: 10px; align-items: baseline; }
    .price-card li::before { content: "✓"; color: var(--success); font-weight: 700; }
    .price-note { font-size: 13px; color: var(--dim); margin-top: 18px; }

    /* ── Guides ──────────────────────────── */
    .guides-list {
      list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 24px;
    }
    .guides-list a { font-size: 15px; color: var(--text); }
    .guides-list a:hover { color: var(--accent); }
    .guides-all { display: inline-block; margin-top: 20px; font-size: 15px; font-weight: 600; }

    /* ── FAQ ─────────────────────────────── */
    .faq-wrap { max-width: 820px; }
    .faq h2 { margin-bottom: 32px; }
    .faq-item {
      background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
      margin-bottom: 12px; overflow: hidden;
    }
    .faq-item summary {
      list-style: none; cursor: pointer; padding: 18px 22px;
      font-size: 16px; font-weight: 600; color: var(--text);
      display: flex; justify-content: space-between; align-items: center; gap: 16px;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after {
      content: '+'; color: var(--accent); font-size: 20px; font-weight: 400; flex-shrink: 0;
    }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item summary:hover { color: var(--accent); }
    .faq-item p {
      color: var(--muted); font-size: 15px; line-height: 1.65;
      padding: 0 22px 20px;
    }
    .faq-more[data-collapsed] { display: none; }
    .faq-toggle {
      display: inline-flex; align-items: center; gap: 6px; margin-top: 8px;
      background: none; border: 1px solid var(--border-md); border-radius: 12px;
      color: var(--accent); font: inherit; font-size: 15px; font-weight: 600;
      padding: 12px 20px; min-height: 48px; cursor: pointer;
    }
    .faq-toggle:hover { border-color: var(--accent); }
    .faq-toggle[hidden] { display: none; }

    /* ── Directory badges ───────────────── */
    .badges-strip { border-top: 1px solid var(--border); padding-top: 32px; padding-bottom: 32px; text-align: center; }
    .badges-strip .section-label { margin-bottom: 16px; }
    .badges-row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px; }
    .badge-pill {
      display: inline-flex; align-items: center;
      padding: 8px 16px; border: 1px solid var(--border); border-radius: 999px;
      font-size: 14px; font-weight: 600; color: var(--text); text-decoration: none;
      transition: border-color .2s, color .2s;
    }
    .badge-pill:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

    /* ── Footer ──────────────────────────── */
    footer {
      border-top: 1px solid var(--border);
      padding-top: 28px; padding-bottom: 28px;
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px;
      font-size: 14px; color: var(--dim);
    }
    footer a { color: var(--muted); }
    footer a:hover { color: var(--text); text-decoration: none; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: center; }

    /* ── Sticky CTA ──────────────────────── */
    .sticky-cta {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      display: flex; align-items: center; justify-content: center; gap: 14px;
      padding: 12px 20px;
      background: rgba(12,12,24,0.92);
      backdrop-filter: blur(14px);
      border-top: 1px solid var(--border);
      transform: translateY(100%);
      transition: transform 0.25s ease;
    }
    .sticky-cta.is-visible { transform: translateY(0); }
    .sticky-cta span { font-size: 14px; color: var(--muted); }
    .sticky-cta .btn-primary { padding: 10px 18px; font-size: 14px; }
    @media (max-width: 560px) { .sticky-cta span { display: none; } }

    /* ── Responsive ──────────────────────── */
    @media (max-width: 1000px) {
      .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .cards { grid-template-columns: 1fr; }
      .platforms-grid { grid-template-columns: 1fr; gap: 32px; }
    }
    @media (max-width: 860px) {
      .hero { grid-template-columns: 1fr; gap: 40px; }
      .hero-phone-frame { width: 240px; padding: 6px; border-radius: 30px; }
      .hero-phone-frame img { border-radius: 24px; }
      .hero-phone::before { width: 340px; height: 340px; margin: -170px 0 0 -170px; }

      /* backdrop-filter on <nav> makes it a containing block for fixed-position
         descendants, which breaks the drawer's fixed positioning. Drop the blur on mobile. */
      nav { backdrop-filter: none; background: rgba(12,12,24,0.98); }

      .nav-toggle { display: flex; }
      .nav-links {
        position: fixed; top: 64px; right: 0; bottom: 0; width: min(75vw, 290px);
        background: var(--surface); border-left: 1px solid var(--border);
        flex-direction: column; align-items: flex-start; gap: 4px;
        padding: 20px; z-index: 9;
        transform: translateX(100%); transition: transform 0.25s ease;
      }
      .nav-links.is-open { transform: translateX(0); }
      .nav-links a { padding: 12px 4px; width: 100%; }
      .nav-links a.btn-nav { width: auto; padding: 12px 18px; margin-top: 12px; }
      .lang-dropdown { padding: 8px 4px; }
    }
    @media (max-width: 640px) {
      .steps { grid-template-columns: 1fr; }
      .guides-list { grid-template-columns: 1fr; }
      .price-card { width: 100%; }
      .hero-body { font-size: 17px; }
      .platform { flex-wrap: wrap; }
      .platform .code-chip { margin-left: 56px; }
      footer { flex-direction: column; align-items: flex-start; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
      html { scroll-behavior: auto; }
    }
  </style>