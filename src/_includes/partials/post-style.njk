  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ground: #0C0C18; --surface: #141428; --elevated: #1E1E38;
      --border: #20203A; --border-md: #2C2C50; --accent: #E8622A;
      --success: #00BF8A; --text: #ECEDFF; --muted: #8888B0; --dim: #7C7CA2;
    }
    html { scroll-behavior: smooth; }
    body {
      background: var(--ground); color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
    nav {
      position: sticky; top: 0; z-index: 10;
      background: rgba(12,12,24,0.90); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      padding: 0 clamp(20px, 5vw, 80px);
      display: flex; align-items: center; justify-content: space-between; height: 60px;
    }
    .nav-brand { font-weight: 700; font-size: 15px; letter-spacing: 0.02em; color: var(--text); display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-links { display: flex; gap: 28px; }
    .nav-links a { color: var(--muted); font-size: 14px; }
    .nav-links a:hover { color: var(--text); text-decoration: none; }

    .lang-dropdown { position: relative; }
    .lang-dropdown-toggle {
      display: flex; align-items: center; gap: 6px;
      background: none; border: none; cursor: pointer;
      color: var(--muted); font-size: 14px; font-family: inherit; padding: 0;
    }
    .lang-dropdown-toggle:hover { color: var(--text); }
    .lang-dropdown-toggle svg { transition: transform 0.2s ease; }
    .lang-dropdown.is-open .lang-dropdown-toggle svg { transform: rotate(180deg); }
    .lang-dropdown-menu {
      position: absolute; top: calc(100% + 14px); right: 0;
      background: var(--surface); border: 1px solid var(--border-md); border-radius: 10px;
      padding: 6px; min-width: 140px;
      display: none; flex-direction: column;
      box-shadow: 0 12px 30px -8px rgba(0,0,0,0.5);
      z-index: 20;
    }
    .lang-dropdown.is-open .lang-dropdown-menu { display: flex; }
    .lang-dropdown-menu a {
      padding: 8px 12px; border-radius: 6px; font-size: 14px; color: var(--muted);
      white-space: nowrap;
    }
    .lang-dropdown-menu a:hover { background: var(--elevated); color: var(--text); text-decoration: none; }
    .lang-dropdown-menu a.is-current { color: var(--accent); font-weight: 600; }
    main { max-width: 720px; margin: 0 auto; padding: clamp(48px, 7vw, 80px) clamp(20px, 5vw, 80px) clamp(80px, 10vw, 120px); }
    .page-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
    h1 { font-size: clamp(30px, 4.5vw, 42px); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px; line-height: 1.2; }
    .post-meta { color: var(--dim); font-size: 13px; margin-bottom: 40px; }
    h2 { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; margin: 40px 0 14px; }
{% if h3Style %}    h3 { font-size: 17px; font-weight: 700; color: var(--text); margin: 24px 0 10px; }
{% endif %}    p { color: var(--muted); font-size: 16px; line-height: 1.75; margin-bottom: 16px; }
    ul, ol { color: var(--muted); font-size: 16px; line-height: 1.75; padding-left: 22px; margin-bottom: 16px; }
    li { margin-bottom: 8px; }
    strong { color: var(--text); }
{% if carrierTable %}    .carrier-table { width: 100%; border-collapse: collapse; margin: 20px 0 28px; font-size: 14px; }
    .carrier-table th, .carrier-table td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--border); }
    .carrier-table th { color: var(--dim); font-weight: 700; text-transform: uppercase; font-size: 11px; letter-spacing: 0.06em; }
    .carrier-table td { color: var(--muted); }
    .carrier-table td:first-child { color: var(--text); font-weight: 600; }
{% endif %}    .callout { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 22px 24px; margin: 28px 0; }
    .callout p:last-child { margin-bottom: 0; }
    .cta-box {
      margin-top: 48px; padding: 28px; border-radius: 16px; background: var(--surface); border: 1px solid var(--border-md);
      display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "title button" "text button";
      column-gap: 24px; align-items: center;
    }
    .cta-box h3 { grid-area: title; font-size: 19px; margin-bottom: 6px; color: var(--text); }
    .cta-box p { grid-area: text; font-size: 15px; line-height: 1.6; margin-bottom: 0; }
    .cta-button { grid-area: button; display: inline-block; background: var(--accent); color: #fff; font-weight: 700; font-size: 15px; padding: 12px 24px; border-radius: 10px; white-space: nowrap; }
    .cta-button:hover { text-decoration: none; opacity: 0.92; }
    .related { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border); }
    .related h3 { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--dim); margin-bottom: 12px; }
    .related ul { padding-left: 0; list-style: none; }
    .related li { margin-bottom: 6px; }
    .related-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-bottom: 14px; }
    .related-card { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; background: var(--surface); border: 1px solid var(--border-md); border-radius: 14px; color: var(--text); }
    .related-card:hover { text-decoration: none; border-color: var(--accent); }
    .related-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; color: var(--accent); }
    .related-title { font-size: 16px; font-weight: 600; line-height: 1.4; }

    /* Carrier page layout (breadcrumb, quick answer, on this page, steps, FAQ) */
    .breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; color: var(--dim); margin-bottom: 14px; }
    .breadcrumb a { color: var(--dim); }
    .breadcrumb-current { color: var(--muted); }
    .quick-answer { background: var(--surface); border: 1px solid var(--border-md); border-radius: 16px; overflow: hidden; margin: -8px 0 36px; }
    .quick-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 22px; border-bottom: 1px solid var(--border); }
    .quick-label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
    .quick-checked { font-size: 12px; color: var(--dim); }
    .quick-row { display: grid; grid-template-columns: 180px minmax(0, 1fr); border-bottom: 1px solid var(--border); }
    .quick-row:last-child { border-bottom: none; }
    .quick-k { padding: 16px 22px; font-size: 13px; font-weight: 700; color: var(--dim); text-transform: uppercase; letter-spacing: 0.06em; }
    .quick-v { padding: 16px 22px 16px 0; font-size: 16px; color: var(--text); line-height: 1.5; }
    .quick-v b, .quick-v strong { font-weight: 700; }
    .toc { display: flex; flex-direction: column; gap: 6px; padding-bottom: 32px; border-bottom: 1px solid var(--border); margin-bottom: 8px; }
    .toc-label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); margin-bottom: 6px; }
    .toc a { font-size: 15px; color: var(--muted); }
    .toc a:hover { color: var(--text); text-decoration: none; }
    h2[id] { scroll-margin-top: 80px; }
    ol.steps { list-style: none; padding-left: 0; counter-reset: step; display: flex; flex-direction: column; gap: 12px; }
    ol.steps > li { counter-increment: step; position: relative; padding-left: 52px; min-height: 32px; margin-bottom: 0; }
    ol.steps > li::before {
      content: counter(step); position: absolute; left: 0; top: 0; width: 32px; height: 32px; border-radius: 50%;
      background: var(--elevated); border: 1px solid var(--border-md); color: var(--accent);
      font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center;
    }
    ol.steps > li > strong:first-child { display: block; padding-top: 4px; color: var(--text); }
    .faq { margin-bottom: 8px; }
    .faq details { border-bottom: 1px solid var(--border); padding: 18px 0; }
    .faq summary { list-style: none; cursor: pointer; font-size: 17px; font-weight: 600; color: var(--text); display: flex; justify-content: space-between; gap: 16px; }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after { content: "+"; color: var(--accent); font-size: 20px; line-height: 1; }
    .faq details[open] summary::after { content: "−"; }
    .faq details p { margin: 10px 0 0; }
    @media (max-width: 560px) {
      .cta-box { grid-template-columns: 1fr; grid-template-areas: "title" "text" "button"; }
      .cta-button { justify-self: start; margin-top: 18px; }
      .related-cards { grid-template-columns: 1fr; }
      .quick-row { grid-template-columns: 1fr; }
      .quick-k { padding: 14px 18px 0; }
      .quick-v { padding: 4px 18px 14px; }
    }
    footer {
      border-top: 1px solid var(--border); padding: 28px clamp(20px, 5vw, 80px);
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;
    }
    .footer-brand { font-size: 13px; color: var(--dim); }
    .footer-brand a { color: var(--muted); }
    .footer-brand a:hover { color: var(--text); text-decoration: none; }
    .footer-links { display: flex; gap: 24px; }
    .footer-links a { font-size: 13px; color: var(--dim); }
    .footer-links a:hover { color: var(--muted); text-decoration: none; }
  </style>